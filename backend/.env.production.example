# Copy to backend/.env on the production host, then supply secrets through
# the host's protected environment file/secret store.
APP_NAME=TradeX
APP_ENV=production
APP_DEBUG=false
API_VERSION_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=https://desk.example.com
DATABASE_PATH=tradex.db

# Keep live execution off through integration, failure-recovery, and paper E2E.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
CREDENTIALS_KEY=

DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

PAPER_STARTING_BALANCE_INR=100000
PAPER_LEDGER_PATH=paper_ledger.json
PAPER_LEDGER_DIR=paper_ledgers
