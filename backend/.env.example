APP_NAME=TradeX
APP_ENV=development
APP_DEBUG=true
API_VERSION_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_PATH=tradex.db

# paper fills inside this process. live sends orders through Dhan.
# Changing this requires a process restart.
TRADING_MODE=paper
PAPER_STARTING_BALANCE_INR=100000
PAPER_LEDGER_PATH=paper_ledger.json
PAPER_LEDGER_DIR=paper_ledgers

# First admin, created only when the user table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs the login cookie. Use a long random string.
SESSION_SECRET=dev-session-secret-change-me

# Fernet key for each trader's Dhan client id and access token.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# Optional process-level Dhan login, used for the security master when a
# trader token is not available. Live funds, positions, quotes, and orders
# use the pair that trader saved in Settings, and refuse to run without it.
# That access token expires after 24 hours. While this process is running it
# renews the saved token before expiry. A stopped process cannot renew it.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Suggestions only. The model cannot place an order.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Startup defaults. An admin can change these from Settings while the process runs.
MAX_POSITIONS=4
CAPITAL_PER_TRADE_PCT=0.20
CASH_RESERVE_PCT=0.10
TAKE_PROFIT_PCT=1.5
STOP_LOSS_PCT=1.0
MAX_DAILY_LOSS_INR=2000
CYCLE_INTERVAL_SECONDS=180
SCREENER_LIMIT=6
