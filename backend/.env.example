APP_NAME=TradeX
APP_ENV=development
APP_DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# paper fills inside this process. live sends orders through Dhan.
# Changing this requires a process restart.
TRADING_MODE=paper
PAPER_STARTING_BALANCE_INR=100000

# First admin, created only when the user table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs the login cookie. Use a long random string.
SESSION_SECRET=dev-session-secret-change-me

# Fernet key for each trader's Dhan client id and access token.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# Optional process-level Dhan login, used for market data.
# Each trader saves their own pair from the settings screen.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Suggestions only. The model cannot place an order.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

FRONTEND_ORIGIN=http://localhost:5173
DATABASE_PATH=tradex.db
